{
  "version": "frame-ir/1.0",
  "intent": "The projection of a onto b is the shadow a casts on b",
  "frame": {
    "aspect": "16:9",
    "pixels": [1920, 1080],
    "units": [16, 9],
    "platform": "plain",
    "background": "#0E1117",
    "subtitle": {"mode": "none", "lines": 2},
    "safe": [-7.6, -4.1, 7.6, 4.1]
  },
  "typography": {
    "lang": "en",
    "text_font": "Inter",
    "math": "latin-modern",
    "sizes": {"title": 64, "heading": 52, "body": 42, "label": 38, "caption": 34}
  },
  "colors": {"a": "#FFD43B", "b": [88, 196, 221], "proj": "#83C167"},
  "styles": {
    "muted": {"opacity": 0.35},
    "construction": {"dash": [14, 10], "stroke_width": 3, "opacity": 0.6}
  },
  "values": {
    "a_x": 2, "a_y": 3,
    "b_x": 4, "b_y": 0,
    "k": "(a_x*b_x + a_y*b_y) / (b_x**2 + b_y**2)"
  },
  "focus": ["proj_ab"],
  "extra_colors": {"ink": "#FFFFFF"},
  "spaces": [{"id": "P", "origin": [-2.2, -1.0], "unit": 1.1}],
  "objects": [
    {"id": "title", "type": "text", "text": "Projection of a onto b", "at": "safe.center_top",
     "anchor": "center_top", "size": "heading", "weight": "bold"},
    {"id": "drop", "type": "line", "in": "P", "start": "a.tip", "end": "proj_ab.tip",
     "style": "construction"},
    {"id": "b", "type": "line", "in": "P", "start": [0, 0], "end": ["b_x", "b_y"], "color": "b",
     "stroke_width": 6, "arrows": ["end"], "label": {"tex": "b", "at": "tip", "dir": "down_right"}},
    {"id": "a", "type": "line", "in": "P", "start": [0, 0], "end": ["a_x", "a_y"], "color": "a",
     "stroke_width": 6, "arrows": ["end"], "label": {"tex": "a", "at": "tip", "dir": "up_right"}},
    {"id": "proj_ab", "type": "line", "in": "P", "start": [0, 0], "end": ["k*b_x", "k*b_y"],
     "color": "proj", "stroke_width": 9, "arrows": ["end"], "z": 1},
    {"id": "angle", "type": "arc", "in": "P", "center": [0, 0], "radius": 0.6, "start_angle": 0,
     "end_angle": "180*atan2(a_y, a_x)/pi", "stroke_width": 3,
     "label": {"tex": "\\theta", "at": "mid", "dir": 30, "gap": 0.1}},
    {"id": "origin", "type": "circle", "in": "P", "center": [0, 0], "radius": 0.07, "fill": "ink",
     "color": "none", "z": 2},
    {"id": "formula_name", "type": "text", "text": "projection:", "size": "body"},
    {"id": "formula_tex", "type": "math", "size": "body",
     "tex": "\\operatorname{proj}_b a = \\frac{a \\cdot b}{b \\cdot b}\\, b"},
    {"id": "formula", "type": "stack", "arrange": "row", "children": ["formula_name", "formula_tex"],
     "align": "center_baseline", "next_to": "b", "dir": "down", "gap": 0.6}
  ]
}
