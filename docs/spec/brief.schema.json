{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "description": "What the picture must do, and what it should do if it can.",
      "properties": {
        "must": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Must",
          "type": "array"
        },
        "should": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Should",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "FontPair": {
      "additionalProperties": false,
      "description": "A text font and a matching math font; which pairs are allowed is decided later.",
      "properties": {
        "text": {
          "default": "Inter",
          "title": "Text",
          "type": "string"
        },
        "math": {
          "default": "latin-modern",
          "title": "Math",
          "type": "string"
        }
      },
      "title": "FontPair",
      "type": "object"
    },
    "Insets": {
      "additionalProperties": false,
      "description": "Space on each side of the picture, in reference pixels.",
      "properties": {
        "top": {
          "default": 0,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        },
        "right": {
          "default": 0,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "bottom": {
          "default": 0,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "default": 0,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        }
      },
      "title": "Insets",
      "type": "object"
    },
    "ModularScale": {
      "additionalProperties": false,
      "description": "A base size and a ratio: each role is one step of the ratio from the next.",
      "properties": {
        "base": {
          "description": "the body size, in reference px",
          "exclusiveMinimum": 0,
          "title": "Base",
          "type": "number"
        },
        "ratio": {
          "exclusiveMinimum": 1,
          "maximum": 2,
          "title": "Ratio",
          "type": "number"
        }
      },
      "required": [
        "base",
        "ratio"
      ],
      "title": "ModularScale",
      "type": "object"
    },
    "MustShow": {
      "additionalProperties": false,
      "description": "Something the picture must show, with an id the IR can name (``\"covers\": [\"m1\"]``).",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "MustShow",
      "type": "object"
    },
    "ProfileChanges": {
      "additionalProperties": false,
      "description": "The parts of the render profile a frame (or a project, or the user) changes.\n\nEvery field is optional: what is not written comes from the layer below.\nNested parts change field by field too: ``{\"subtitle\": {\"mode\": \"burn_in\"}}``\nkeeps the number of lines the lesson chose.",
      "properties": {
        "aspect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspect"
        },
        "resolution": {
          "anyOf": [
            {
              "maximum": 4320,
              "minimum": 360,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "margins": {
          "anyOf": [
            {
              "$ref": "#/$defs/Insets"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subtitle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subtitle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "typography": {
          "anyOf": [
            {
              "$ref": "#/$defs/Typography"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "theme": {
          "anyOf": [
            {
              "$ref": "#/$defs/Theme"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ProfileChanges",
      "type": "object"
    },
    "Subtitle": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/SubtitleMode",
          "default": "none"
        },
        "lines": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Lines",
          "type": "integer"
        },
        "line_spacing": {
          "default": 1.2,
          "maximum": 2.0,
          "minimum": 1.0,
          "title": "Line Spacing",
          "type": "number"
        }
      },
      "title": "Subtitle",
      "type": "object"
    },
    "SubtitleMode": {
      "enum": [
        "none",
        "reserve",
        "burn_in"
      ],
      "title": "SubtitleMode",
      "type": "string"
    },
    "Texts": {
      "additionalProperties": false,
      "description": "Words that appear in the picture exactly as written, in the frame's language.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "labels": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_]*$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Labels",
          "type": "object"
        },
        "subtitle": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        }
      },
      "title": "Texts",
      "type": "object"
    },
    "Theme": {
      "additionalProperties": false,
      "description": "Background and defaults; a text or line color left out contrasts with the background.",
      "properties": {
        "background": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            }
          ],
          "default": "#0E1117",
          "title": "Background"
        },
        "text": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "line": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "stroke_width": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Stroke Width",
          "type": "number"
        }
      },
      "title": "Theme",
      "type": "object"
    },
    "Typography": {
      "additionalProperties": false,
      "properties": {
        "font_pair": {
          "$ref": "#/$defs/FontPair"
        },
        "scale": {
          "anyOf": [
            {
              "enum": [
                "compact",
                "comfortable",
                "large"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModularScale"
            }
          ],
          "default": "comfortable",
          "title": "Scale"
        },
        "lang": {
          "default": "en",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
          "title": "Lang",
          "type": "string"
        }
      },
      "title": "Typography",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "brief.json: what one picture must do.",
  "properties": {
    "version": {
      "const": "frame-brief/1.0",
      "default": "frame-brief/1.0",
      "title": "Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "lesson": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lesson"
    },
    "purpose": {
      "enum": [
        "introduce",
        "define",
        "example",
        "counterexample",
        "summary"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "intent": {
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "focus": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
        "type": "string"
      },
      "title": "Focus",
      "type": "array"
    },
    "must_show": {
      "items": {
        "$ref": "#/$defs/MustShow"
      },
      "minItems": 1,
      "title": "Must Show",
      "type": "array"
    },
    "texts": {
      "$ref": "#/$defs/Texts"
    },
    "concept_colors": {
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*$": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            }
          ]
        }
      },
      "title": "Concept Colors",
      "type": "object"
    },
    "notation": {
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Notation",
      "type": "object"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "render_profile": {
      "$ref": "#/$defs/ProfileChanges"
    },
    "composition_notes": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Composition Notes"
    }
  },
  "required": [
    "id",
    "purpose",
    "intent",
    "must_show"
  ],
  "title": "FrameBrief",
  "type": "object"
}
