{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FontPair": {
      "additionalProperties": false,
      "description": "A text font and a matching math font; which pairs are allowed is decided later.",
      "properties": {
        "text": {
          "default": "Inter",
          "title": "Text",
          "type": "string"
        },
        "math": {
          "default": "latin-modern",
          "title": "Math",
          "type": "string"
        }
      },
      "title": "FontPair",
      "type": "object"
    },
    "Insets": {
      "additionalProperties": false,
      "description": "Space on each side of the picture, in reference pixels.",
      "properties": {
        "top": {
          "default": 0,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        },
        "right": {
          "default": 0,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "bottom": {
          "default": 0,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "default": 0,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        }
      },
      "title": "Insets",
      "type": "object"
    },
    "ModularScale": {
      "additionalProperties": false,
      "description": "A base size and a ratio: each role is one step of the ratio from the next.",
      "properties": {
        "base": {
          "description": "the body size, in reference px",
          "exclusiveMinimum": 0,
          "title": "Base",
          "type": "number"
        },
        "ratio": {
          "exclusiveMinimum": 1,
          "maximum": 2,
          "title": "Ratio",
          "type": "number"
        }
      },
      "required": [
        "base",
        "ratio"
      ],
      "title": "ModularScale",
      "type": "object"
    },
    "Subtitle": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/SubtitleMode",
          "default": "none"
        },
        "lines": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Lines",
          "type": "integer"
        },
        "line_spacing": {
          "default": 1.2,
          "maximum": 2.0,
          "minimum": 1.0,
          "title": "Line Spacing",
          "type": "number"
        }
      },
      "title": "Subtitle",
      "type": "object"
    },
    "SubtitleMode": {
      "enum": [
        "none",
        "reserve",
        "burn_in"
      ],
      "title": "SubtitleMode",
      "type": "string"
    },
    "Theme": {
      "additionalProperties": false,
      "description": "Background and defaults; a text or line color left out contrasts with the background.",
      "properties": {
        "background": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            }
          ],
          "default": "#0E1117",
          "title": "Background"
        },
        "text": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "line": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "stroke_width": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Stroke Width",
          "type": "number"
        }
      },
      "title": "Theme",
      "type": "object"
    },
    "Typography": {
      "additionalProperties": false,
      "properties": {
        "font_pair": {
          "$ref": "#/$defs/FontPair"
        },
        "scale": {
          "anyOf": [
            {
              "enum": [
                "compact",
                "comfortable",
                "large"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModularScale"
            }
          ],
          "default": "comfortable",
          "title": "Scale"
        },
        "lang": {
          "default": "en",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
          "title": "Lang",
          "type": "string"
        }
      },
      "title": "Typography",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything about the frame that is decided before any object is drawn.",
  "properties": {
    "aspect": {
      "title": "Aspect",
      "type": "string"
    },
    "resolution": {
      "default": 1080,
      "maximum": 4320,
      "minimum": 360,
      "title": "Resolution",
      "type": "integer"
    },
    "platform": {
      "default": "plain",
      "title": "Platform",
      "type": "string"
    },
    "margins": {
      "$ref": "#/$defs/Insets"
    },
    "subtitle": {
      "$ref": "#/$defs/Subtitle"
    },
    "typography": {
      "$ref": "#/$defs/Typography"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    }
  },
  "required": [
    "aspect"
  ],
  "title": "RenderProfile",
  "type": "object"
}
